{
  "name": "minecraft-xplay-web-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @xplay/frontend",
    "dev:backend": "npm run start:dev --workspace @xplay/backend",
    "dev:db": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait db",
    "dev:db:stop": "docker compose -f compose.yaml -f compose.dev.yaml stop db",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace @xplay/backend",
    "test:frontend": "npm run test --workspace @xplay/frontend",
    "test:e2e": "npm run test:e2e --workspace @xplay/frontend",
    "test:e2e:install": "npm run test:e2e:install --workspace @xplay/frontend",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
    "docker:dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "docker:prod": "docker compose up --build -d",
    "docker:prod:down": "docker compose down"
  },
  "devDependencies": {
    "pict-node": "^1.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
