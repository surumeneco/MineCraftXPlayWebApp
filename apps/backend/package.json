{
  "name": "@xplay/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "nest start",
    "start:dev": "node scripts/migrate.mjs && nest start --watch",
    "start:prod": "node scripts/migrate.mjs && node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "postgres": "3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "engines": { "node": ">=24" }
}
