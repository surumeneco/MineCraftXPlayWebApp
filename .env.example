POSTGRES_DB=xplay
POSTGRES_USER=xplay
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
PUBLIC_API_BASE=http://localhost:3001/api

# Discord OAuth2 identify login is available to any Discord user. Never commit real secrets.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Bootstrap: grant admin on login only when there is no administrator in the DB.
# Protection: accounts linked to any ID still listed here cannot lose admin rights,
# be deleted or disappear as a merge source. Other profile fields remain editable.
# Keep the initial administrator ID configured after first login.
# Grant/revoke ordinary administrator roles at /admin/accounts/:id/edit.
ADMIN_DISCORD_IDS=

# Required to publish notices or change a published notice's body. Both
# services must share NOTICE_NOTIFY_SECRET (at least 32 bytes); keep it out of Git.
# Use the Bot's private Docker network alias when using compose.notice.yaml.
NOTICE_BOT_URL=http://xplay-notice-bot:3101
NOTICE_NOTIFY_SECRET=
# Public frontend origin, without /info/notice; must be HTTPS outside localhost.
NOTICE_PUBLIC_BASE_URL=http://localhost:3000
